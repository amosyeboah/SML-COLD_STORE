{
  "name": "sml-cold-store",
  "version": "1.0.0",
  "description": "SML Legacy Limited - Offline Cold Store Management & POS System",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "web:dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:electron": "electron-vite build",
    "web:serve": "npx serve dist -l 5173",
    "preview": "electron-vite preview",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "build:win": "npm run prisma:generate && npm run build:electron && electron-builder --win",
    "build:win:clean": "npx rimraf dist out generated && npm run build:win",
    "cap:build": "electron-vite build",
    "cap:add": "npx cap add android",
    "cap:sync": "electron-vite build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.17.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.51.21",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.414.0",
    "pdfkit": "^0.15.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.12",
    "@types/pdfkit": "^0.13.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.40",
    "prisma": "^5.17.0",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "com.smllegacy.coldstore",
    "productName": "SML Legacy Cold Store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "generated/**",
      "prisma/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "generated/**",
      "node_modules/@prisma/client/**",
      "node_modules/@prisma/engines/**",
      "node_modules/.prisma/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SMLLegacyColdStore-${version}-setup.exe"
    }
  }
}
