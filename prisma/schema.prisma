generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "windows"]
  engineType    = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database/pharmacy.db"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  pin       String?
  role      String   // ADMIN, CASHIER
  createdAt DateTime @default(now())
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  contact   String?
  email     String?
  address   String?
  purchases Purchase[]
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  phone         String?        @unique
  sales         Sale[]
  prescriptions Prescription[]
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  medicines Medicine[]
}

model Medicine {
  id            String          @id @default(uuid())
  name          String
  genericName   String?
  sku           String          @unique // Barcode/SKU
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  price         Float           // Selling price
  cost          Float           // Default purchase cost
  minStockLevel Int             @default(10)
  batches       Batch[]
  stockMovements StockMovement[]
}

model Batch {
  id             String          @id @default(uuid())
  medicineId     String
  medicine       Medicine        @relation(fields: [medicineId], references: [id])
  batchNumber    String
  expiryDate     DateTime
  quantity       Int             // Current stock in this batch
  purchaseItemId String?
  purchaseItem   PurchaseItem?   @relation(fields: [purchaseItemId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]
}

model Purchase {
  id         String         @id @default(uuid())
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  date       DateTime       @default(now())
  total      Float
  status     String         // PENDING, COMPLETED
  deviceId   String?
  device     Device?        @relation(fields: [deviceId], references: [deviceId])
  items      PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  medicineId String
  quantity   Int
  cost       Float
  batches    Batch[]
}

model Sale {
  id            String         @id @default(uuid())
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  date          DateTime       @default(now())
  total         Float
  paymentMethod String         // CASH, MOBILE, CARD, SPLIT
  deviceId      String?
  device        Device?        @relation(fields: [deviceId], references: [deviceId])
  payments      SalePayment[]
  items         SaleItem[]
  prescription  Prescription?
}

model SalePayment {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String   // CASH, MOBILE, CARD, BANK TRANSFER
  amount    Float
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id])
  quantity   Int
  price      Float    // Price at time of sale
}

model Prescription {
  id           String    @id @default(uuid())
  saleId       String    @unique
  sale         Sale      @relation(fields: [saleId], references: [id])
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  doctorName   String
  notes        String?
  date         DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // PRICE_CHANGE, BATCH_RECEIVE, BATCH_DELETE, USER_UPDATE, etc.
  category  String   // AUTH, PRICING, INVENTORY, PURCHASES, SALES, SYSTEM
  details   String   // Human-readable summary
  username  String   // Actor
  userRole  String   // ADMIN, MANAGER, CASHIER
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  deviceId  String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())
}

model Device {
  id             String          @id @default(uuid())
  deviceId       String          @unique
  storeId        String          @default("sml_accra_main")
  deviceName     String
  deviceType     String          // DESKTOP, TABLET, MOBILE, WEB
  appVersion     String?         @default("1.0.0")
  ipAddress      String?
  lastSeen       DateTime        @default(now())
  status         String          @default("ACTIVE") // ACTIVE, REVOKED, OFFLINE
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  purchases      Purchase[]
  stockMovements StockMovement[]
}

model StockMovement {
  id            String    @id @default(uuid())
  storeId       String    @default("sml_accra_main")
  productId     String
  medicine      Medicine  @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?    @relation(fields: [batchId], references: [id])
  quantityDelta Int       // positive = addition, negative = deduction
  movementType  String    // PURCHASE, SALE, RETURN, ADJUSTMENT_IN, ADJUSTMENT_OUT, DAMAGE, EXPIRED, TRANSFER_IN, TRANSFER_OUT
  referenceType String    // SALE, PURCHASE, ADJUSTMENT, INITIAL, MANUAL
  referenceId   String?
  unitCost      Float?
  unitPrice     Float?
  userId        String?
  deviceId      String?
  device        Device?   @relation(fields: [deviceId], references: [deviceId])
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([productId])
  @@index([batchId])
  @@index([movementType])
  @@index([createdAt])
}

model SyncOutbox {
  id             String    @id @default(uuid())
  eventId        String    @unique @default(uuid())
  storeId        String    @default("sml_accra_main")
  entity         String    // SALE, PRODUCT, BATCH, PURCHASE, STOCK_MOVEMENT, AUDIT_LOG, CUSTOMER, SUPPLIER
  action         String    // INSERT, UPDATE, DELETE
  recordId       String
  payload        String    // JSON string
  entityType     String?   // Alias for entity
  entityId       String?   // Alias for recordId
  operation      String?   // Alias for action
  aggregateType  String?
  aggregateId    String?
  status         String    @default("PENDING") // PENDING, PROCESSING, SYNCED, FAILED, DEAD_LETTER
  attempts       Int       @default(0)
  retryCount     Int       @default(0)
  lastAttempt    DateTime?
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  errorMessage   String?
  lastError      String?
  deviceId       String?
  createdAt      DateTime  @default(now())
  syncedAt       DateTime?
  processedAt    DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([nextAttemptAt])
  @@index([entity])
}

model SyncInbox {
  id         String    @id @default(uuid())
  eventId    String    @unique
  storeId    String    @default("sml_accra_main")
  entityType String
  entityId   String
  operation  String
  payload    String    // JSON string
  receivedAt DateTime  @default(now())
  appliedAt  DateTime?
  status     String    @default("PENDING") // PENDING, APPLIED, FAILED, SKIPPED
  error      String?

  @@index([status])
  @@index([receivedAt])
}

model SyncCursor {
  key         String   @id
  cursorValue String
  updatedAt   DateTime @updatedAt
}

model SyncSession {
  id              String    @id @default(uuid())
  deviceId        String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String    @default("SUCCESS") // SUCCESS, PARTIAL, FAILED, OFFLINE
  eventsAttempted Int       @default(0)
  eventsSucceeded Int       @default(0)
  eventsFailed    Int       @default(0)
  durationMs      Int?
  latencyMs       Int?
  errorSummary    String?
  details         String?

  @@index([startedAt])
}


